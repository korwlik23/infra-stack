# ── __PROJECT__ (Go) ─────────────────────────────────
# __ROOT:<ชื่อค่า>__ = create-project.sh เติมค่าจาก .env กลางให้อัตโนมัติ
APP_IMAGE=__PROJECT__:latest
APP_DOMAIN=__PROJECT__.__ROOT:BASE_DOMAIN__

# Zero-downtime rolling deploy (docs/25-zero-downtime.md)
ROLLOUT_SERVICE=__PROJECT__
# app ต้องมี route นี้ ตอบ 200 เมื่อพร้อม (แนะนำ ping DB ด้วย)
HEALTHCHECK_PATH=/healthz

# Migrate + seed ตอน deploy ด้วยโค้ดใหม่ ก่อนสลับ traffic (docs/29-deploy-go.md)
# ข้อตกลง: binary รับ subcommand `migrate` และ `seed` (ตัวอย่าง: examples/go-app/)
# ใช้ golang-migrate / goose ก็ได้ — เปลี่ยนคำสั่งด้านล่างให้ตรง (ต้องอยู่ใน image)
DEPLOY_MIGRATE=1
DEPLOY_MIGRATE_CMD=/app/server migrate
# seed = ข้อมูลพื้นฐาน (role / ค่าตั้งต้น) ต้องรันซ้ำได้ — none = ไม่มี seed
DEPLOY_SEED_CMD=/app/server seed
# ไฟล์ seed ใน image (relative กับ WORKDIR) — เปลี่ยนเมื่อไหร่ deploy จะถามว่า seed ไหม
DEPLOY_SEED_PATHS=seeds
# deploy ครั้งแรกบนเครื่องจะถามว่า seed ไหม · ต่อจากนั้น push ที่แก้ seed → seed เอง (seed ต้องรันซ้ำได้)
# 0 = ถามก่อนทุกครั้งที่ seed เปลี่ยน (auto-deploy จะพักรอคนตอบ)
# DEPLOY_AUTO_SEED=0

APP_ENV=production
PORT=8080

# Database — ผ่าน network `backend` (create-project.sh สร้าง database ชื่อ DB_DATABASE ให้)
# ⚠️ รหัสผ่านอยู่ใน URL — ถ้ามีอักขระพิเศษ (@ : / # ? %) ต้อง URL-encode ก่อน
DB_DATABASE=__PROJECT___db
DATABASE_URL=postgres://__ROOT:POSTGRES_USER__:__ROOT:POSTGRES_PASSWORD__@postgres:5432/__PROJECT___db?sslmode=disable

# Redis (cache / queue)
REDIS_URL=redis://:__ROOT:REDIS_PASSWORD__@redis:6379
