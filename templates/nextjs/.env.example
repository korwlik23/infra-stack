# ── __PROJECT__ (Next.js) ────────────────────────────
# __ROOT:<ชื่อค่า>__ = create-project.sh เติมค่าจาก .env กลางให้อัตโนมัติ
APP_IMAGE=ghcr.io/<github-user>/__PROJECT__:latest
APP_DOMAIN=__PROJECT__.__ROOT:BASE_DOMAIN__

# Zero-downtime rolling deploy (docs/25-zero-downtime.md)
ROLLOUT_SERVICE=__PROJECT__
# แนะนำสร้าง /api/health ที่ตอบเร็ว แล้วเปลี่ยนค่านี้ (default: หน้าแรก)
HEALTHCHECK_PATH=/

# กันพังหลัง deploy (docs/25): smoke test หลังสลับเวอร์ชัน · ล้ม → ถอยกลับเวอร์ชันก่อนให้เอง (ไม่ย้อน migration)
DEPLOY_AUTO_ROLLBACK=1
# path ที่เช็คเพิ่มหลัง deploy (ต้องตอบ < 500):
# DEPLOY_SMOKE_PATHS=/login /api/ping
# key ใหม่ใน .env.example ของ app ที่ยังไม่มีใน .env นี้ = หยุด deploy · key ที่เครื่องนี้ไม่ต้องตั้ง:
# DEPLOY_ENV_IGNORE=SOME_KEY OTHER_KEY

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://__PROJECT__.__ROOT:BASE_DOMAIN__

# Migrate + seed ตอน deploy ด้วยโค้ดใหม่ ก่อนสลับ traffic (Prisma — docs/16-deploy-nextjs.md)
# standalone image ไม่มี prisma CLI → Dockerfile ต้องมี stage "migrate" (มี node_modules + prisma/)
# ไม่ใช้ database → ลบ 5 บรรทัดนี้ หรือ DEPLOY_MIGRATE=0
DEPLOY_MIGRATE=1
DEPLOY_TOOLS_TARGET=migrate
DEPLOY_MIGRATE_CMD=npx prisma migrate deploy
# seed = ข้อมูลพื้นฐานเท่านั้น (ห้ามรหัส/API key ตัวอย่างบน production) ต้องรันซ้ำได้ — none = ไม่มี
DEPLOY_SEED_CMD=npx prisma db seed
DEPLOY_SEED_PATHS=prisma/seed.ts prisma/seed.js prisma/seed

# ถ้าใช้ database ตรง (เช่น Prisma) — ผ่าน network `backend`
# create-project.sh สร้าง database ชื่อ DB_DATABASE ให้ (ต้องตรงกับท้าย DATABASE_URL)
DB_DATABASE=__PROJECT___db
# ⚠️ รหัสผ่านอยู่ใน URL — ถ้ามีอักขระพิเศษ (@ : / # ? %) ต้อง URL-encode ก่อน
#    เช่น  p@ss/w0rd → p%40ss%2Fw0rd   (ไม่งั้น connection string จะ parse ผิด)
DATABASE_URL=postgresql://__ROOT:POSTGRES_USER__:__ROOT:POSTGRES_PASSWORD__@postgres:5432/__PROJECT___db

# Redis (cache / rate limit) — รหัสผ่านใน URL เช่นกัน ต้อง URL-encode ถ้ามีอักขระพิเศษ
REDIS_URL=redis://:__ROOT:REDIS_PASSWORD__@redis:6379
