# ── __PROJECT__ (n8n) ────────────────────────────────
# __ROOT:<ชื่อค่า>__ = create-project.sh เติมค่าจาก .env กลางให้อัตโนมัติ
APP_DOMAIN=__PROJECT__.__ROOT:BASE_DOMAIN__
TZ=__ROOT:TZ__

# create-project.sh สุ่มให้ — ⚠️ จดเก็บนอกเครื่อง + ห้ามเปลี่ยนหลังใช้งาน (credentials จะถอดรหัสไม่ได้)
N8N_ENCRYPTION_KEY=__GENERATE__

DB_DATABASE=__PROJECT___db
DB_USERNAME=__ROOT:POSTGRES_USER__
DB_PASSWORD=__ROOT:POSTGRES_PASSWORD__
