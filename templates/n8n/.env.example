# ── __PROJECT__ (n8n) ────────────────────────────────
# __ROOT:<ชื่อค่า>__ = create-project.sh เติมค่าจาก .env กลางให้อัตโนมัติ
APP_DOMAIN=__PROJECT__.__ROOT:BASE_DOMAIN__
TZ=__ROOT:TZ__

# create-project.sh สุ่มให้ — ⚠️ จดเก็บนอกเครื่อง + ห้ามเปลี่ยนหลังใช้งาน (credentials จะถอดรหัสไม่ได้)
N8N_ENCRYPTION_KEY=__GENERATE__

# create-project.sh สร้าง database + user ของ project นี้ (ไม่ใช่ superuser — docs/31)
DB_DATABASE=__PROJECT___db
DB_USERNAME=__DB_USER__
DB_PASSWORD=__DB_PASSWORD__

# อัปเดต n8n เองเมื่อมีเวอร์ชันใหม่ (infra refresh ทุกคืน — docs/31) · image เป็น :latest = อาจข้าม major
# เปิดเมื่อ pin major ใน docker-compose.yml แล้ว ไม่งั้นอัปเดตเอง: infra deploy __PROJECT__
# DEPLOY_REFRESH=1
