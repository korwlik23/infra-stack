# ── InfraStack global configuration ─────────────────
# Copy to .env and edit. NEVER commit the real .env.
# ต้องแก้เองแค่ BASE_DOMAIN กับ ACME_EMAIL — รหัสผ่านทุกตัวที่ลงท้าย _PASSWORD และยังเป็น
# CHANGE_ME ./install.sh สุ่มให้อัตโนมัติ (R2_* เป็น key จาก Cloudflare — ใส่เองเมื่อจะใช้)

# Base domain — every service gets a subdomain of this
BASE_DOMAIN=example.com

# Email used for Let's Encrypt certificate registration
ACME_EMAIL=admin@example.com

# Server timezone
TZ=Asia/Bangkok

# ── หน้าแอดมิน (Traefik dashboard, Netdata, Dozzle, Redis Insight) ──
# หน้าที่ไม่มีระบบ login ของตัวเอง — install.sh สร้าง basicauth จากสองค่านี้ให้
# เปลี่ยนรหัส: แก้ค่านี้แล้วรัน ./install.sh อีกครั้ง
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=CHANGE_ME

# ── PostgreSQL ───────────────────────────────────────
POSTGRES_USER=infra
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=infra

# ── Redis ────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME

# ── Grafana ──────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ── Cloudflare R2 (object storage / backup target) ──
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_BACKUP=backup

# ── pgAdmin (tools stack) ────────────────────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME

# ── RabbitMQ (messaging stack, v2.0) ────────────────
RABBITMQ_USER=infra
RABBITMQ_PASSWORD=CHANGE_ME

# ── MinIO (storage stack, v2.0) ─────────────────────
MINIO_ROOT_USER=infra
MINIO_ROOT_PASSWORD=CHANGE_ME

# ── Beszel agent (multi-server monitoring, v2.0) ────
# public key จากหน้า Add System ของ Beszel hub
BESZEL_AGENT_KEY=

# ── Backup ───────────────────────────────────────────
# เก็บ backup ในเครื่องกี่วัน (ฝั่ง R2 ตั้ง lifecycle rule เอง — docs/13)
BACKUP_KEEP_DAYS=7
# รหัสเข้ารหัส backup ของ .env / cert / token / deploy key — install.sh สุ่มให้
# ⚠️ จดเก็บนอกเครื่อง (password manager) — เครื่องพังแล้วไม่มีรหัสนี้ = กู้ secrets ไม่ได้
BACKUP_ENCRYPTION_PASSWORD=CHANGE_ME
# โฟลเดอร์ของเครื่องนี้ใน R2: r2:<R2_BUCKET_BACKUP>/<BACKUP_HOST>/… — ว่าง = hostname
BACKUP_HOST=
# volume ที่ไม่ backup — ประวัติ metrics/log ที่ใหญ่และสร้างใหม่ได้ (postgres_data ข้ามเสมอ ใช้ pg_dumpall)
BACKUP_EXCLUDE_VOLUMES="netdata_cache prometheus_data loki_data promtail_positions"
