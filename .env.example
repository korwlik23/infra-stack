# ── InfraStack global configuration ─────────────────
# Copy to .env and edit. NEVER commit the real .env.
# ไม่ต้องแก้เอง — ./install.sh ถาม BASE_DOMAIN / ACME_EMAIL ตอนติดตั้งครั้งแรกแล้วเขียนให้
# รหัสผ่านทุกตัวที่ลงท้าย _PASSWORD และยังเป็น CHANGE_ME ./install.sh สุ่มให้อัตโนมัติ
# (R2_* เป็น key จาก Cloudflare — ใส่เองเมื่อจะใช้ backup offsite)

# Base domain — every service gets a subdomain of this
BASE_DOMAIN=example.com

# Email used for Let's Encrypt certificate registration
ACME_EMAIL=admin@example.com

# Server timezone
TZ=Asia/Bangkok

# ── หน้าแอดมิน (Traefik dashboard, Netdata, Dozzle, Redis Insight) ──
# หน้าที่ไม่มีระบบ login ของตัวเอง — install.sh สร้าง basicauth จากสองค่านี้ให้
# เปลี่ยนรหัส: แก้ค่านี้แล้วรัน ./install.sh อีกครั้ง
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=CHANGE_ME

# ── PostgreSQL ───────────────────────────────────────
POSTGRES_USER=infra
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=infra

# ── MySQL (ทางเลือก — เฉพาะ project ที่สร้างด้วย create-project.sh … --mysql) ──
# ไม่ต้องตั้งเอง: create-project.sh --mysql สุ่มให้ครั้งแรกแล้วเปิด MySQL stack (docs/27)
# MYSQL_ROOT_PASSWORD=
# MYSQL_BUFFER_POOL=256M

# ── Redis ────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME

# ── Grafana ──────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ── Portainer ────────────────────────────────────────
# install.sh สร้าง admin ให้ด้วยรหัสนี้ตอนเปิดครั้งแรก (ไม่ต้องรีบสร้างเองภายใน 5 นาที)
PORTAINER_ADMIN_PASSWORD=CHANGE_ME

# ── n8n ที่ install.sh ติดตั้งให้ (ว่าง = ไม่ติดตั้ง) ──
# ตอบ Y ตอนติดตั้ง → install.sh เขียนชื่อเว็บไว้ที่นี่ เพื่อให้รันซ้ำแล้วทำต่อจากที่ค้างได้
INFRA_N8N_DOMAIN=

# ── Cloudflare R2 (object storage / backup target) ──
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_BACKUP=backup

# ── pgAdmin (tools stack) ────────────────────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME

# ── RabbitMQ (messaging stack, v2.0) ────────────────
RABBITMQ_USER=infra
RABBITMQ_PASSWORD=CHANGE_ME

# ── MinIO (storage stack, v2.0) ─────────────────────
MINIO_ROOT_USER=infra
MINIO_ROOT_PASSWORD=CHANGE_ME

# ── Beszel agent (multi-server monitoring, v2.0) ────
# public key จากหน้า Add System ของ Beszel hub
BESZEL_AGENT_KEY=

# ── Backup ───────────────────────────────────────────
# เก็บ backup ในเครื่องกี่วัน (ฝั่ง R2 ตั้ง lifecycle rule เอง — docs/13)
BACKUP_KEEP_DAYS=7
# รหัสเข้ารหัส backup ของ .env / cert / token / deploy key — install.sh สุ่มให้
# ⚠️ จดเก็บนอกเครื่อง (password manager) — เครื่องพังแล้วไม่มีรหัสนี้ = กู้ secrets ไม่ได้
BACKUP_ENCRYPTION_PASSWORD=CHANGE_ME
# โฟลเดอร์ของเครื่องนี้ใน R2: r2:<R2_BUCKET_BACKUP>/<BACKUP_HOST>/… — ว่าง = hostname
BACKUP_HOST=
# volume ที่ไม่ backup — ประวัติ metrics/log ที่ใหญ่และสร้างใหม่ได้ (postgres_data ข้ามเสมอ ใช้ pg_dumpall)
BACKUP_EXCLUDE_VOLUMES="netdata_cache prometheus_data loki_data promtail_positions"

# ── แจ้งเตือนจาก auto-deploy (ไม่บังคับ) ─────────────
# deploy / auto-deploy (ผล deploy, รอคำตอบเรื่อง seed, git fetch ล้ม) → ส่งเข้า Telegram (ว่าง = มีแค่ log) — docs/19
# token จาก @BotFather (ใช้ bot ตัวเดียวกับ Alertmanager ได้) · chat id จาก https://api.telegram.org/bot<token>/getUpdates
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
# deploy.sh แจ้งทุกผล (สำเร็จ / smoke ล้ม / rollback / ล้ม) · auto-deploy แจ้ง git fetch ล้ม — 0 = ไม่แจ้งตอนสำเร็จ
NOTIFY_DEPLOY_SUCCESS=1
# backup.sh (cron 03:00) แจ้งเสมอเมื่อล้ม หรือยังไม่ได้ตั้ง off-site · 1 = แจ้งตอนสำเร็จทุกคืนด้วย
NOTIFY_BACKUP_SUCCESS=0

# ── อัปเดตความปลอดภัย + ล้างขยะ (docs/31) ───────────
# cve-scan.sh (cron 06:00): ระดับที่แจ้ง · เวอร์ชัน Trivy (pin เสมอ — อ่าน release notes ก่อนเปลี่ยน)
# ฐานข้อมูล CVE ใช้ disk ราว 2GB (volume trivy-cache)
CVE_SEVERITY=CRITICAL,HIGH
# ข้ามสแกนเมื่อ disk ว่างน้อยกว่านี้ (GB) — แจ้ง Telegram ครั้งเดียว · CVE_SCAN=0 = ปิดทั้งหมด
CVE_MIN_FREE_GB=10
TRIVY_IMAGE=aquasec/trivy:0.69.3
# cleanup.sh (cron 04:00 + หลัง refresh build): build cache รวมไม่เกินเท่านี้ (เครื่องที่ deploy ทุกวันเคยโตถึง 13GB)
CLEANUP_CACHE_MAX=2gb
# ลบ image ที่ไม่มี container ใช้และไม่ได้ pull ใหม่เกิน N วัน (:previous / base ของ Dockerfile ไม่ลบ) · 0 = ปิด
CLEANUP_IMAGE_DAYS=7
# image ที่ไม่ให้ลบ แม้ไม่มี container ใช้ (คั่นด้วยช่องว่าง)
CLEANUP_KEEP_IMAGES=
# ลบไฟล์ของ user นี้ใน /tmp ที่ไม่ได้แตะเกิน N วัน · 0 = ปิด
CLEANUP_TMP_DAYS=7

# ── ยามเฝ้า VPS (scripts/watch.sh — cron ทุกชั่วโมง · docs/31) ──
# เจอสัญญาณผู้บุกรุก → Telegram ทันที (ไม่ผ่าน AI) · สรุปประจำวันให้ Gemini เรียบเรียง (ต่อ: infra watch --setup)
# WATCH=0 = ปิด · WATCH_N8N_TOKEN — infra watch --setup ตั้งให้เอง
# model (default gemini-flash-lite-latest — ล่มจะลอง gemini-flash-latest ให้เอง)
WATCH_GEMINI_MODEL=
WATCH_REPORT_HOUR=7
# CPU % ของ container (100 = 1 core) ที่ค้าง 2 ชั่วโมงติดแล้วเตือน · ข้อมูลขาออกต่อชั่วโมง (GB)
WATCH_CPU_ALERT=150
WATCH_TX_ALERT_GB=3
# regex ชื่อ container นอก compose ที่เป็นของคุณเอง (ไม่ต้องเตือน) เช่น ^(my-tool|test-)
WATCH_IGNORE_CONTAINERS=
